rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Same admin check as firestore.rules / functions/admin/isAdmin.js.
    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.get('email', '').lower()));
    }

    // Subcategory feeds/chat and user groups (MediaLimits.community in the
    // app): images, a video (≤ 5 min — duration is checked in the app, so
    // the size cap is generous), PDFs and audio of at most 50 MB each.
    function communityFile() {
      return (request.resource.contentType.matches('image/.*')
                && request.resource.size < 8 * 1024 * 1024)
        || (request.resource.contentType.matches('video/.*')
                && request.resource.size < 1024 * 1024 * 1024)
        || (request.resource.contentType == 'application/pdf'
                && request.resource.size <= 50 * 1024 * 1024)
        || (request.resource.contentType.matches('audio/.*')
                && request.resource.size <= 50 * 1024 * 1024);
    }

    match /threadPosts/{postId}/{fileName} {
      allow read: if request.auth != null;
      // Images (up to 5 per post), or one video of at most 10 minutes —
      // duration is checked in the app, so the size cap here is generous.
      allow write: if request.auth != null
        && ((request.resource.size < 8 * 1024 * 1024
              && request.resource.contentType.matches('image/.*'))
          || (request.resource.size < 2 * 1024 * 1024 * 1024
              && request.resource.contentType.matches('video/.*')));
      // Deletes happen via the cleanupThreadPost Cloud Function (Admin SDK,
      // bypasses these rules) when the Firestore doc is deleted.
      allow delete: if false;
    }

    // Private chat attachments — images, video, audio and PDFs of any size —
    // only readable/writable by the two conversation participants. Uses a
    // cross-service Firestore lookup, which Firebase asks to authorise on
    // the first deploy of these rules.
    match /conversations/{conversationId}/{messageId}/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid in firestore.get(
             /databases/(default)/documents/conversations/$(conversationId)).data.participants;
      allow delete: if false;
    }

    // subcategoryFeeds/{categoryId}/posts/{postId}/… and …/messages/{id}/…
    // — open to every signed-in user, like the Firestore docs.
    match /subcategoryFeeds/{categoryId}/{kind}/{itemId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (kind == 'posts' || kind == 'messages')
        && communityFile();
      // Removed by the cleanup Cloud Functions with the post/message.
      allow update, delete: if false;
    }

    // A user group's profile picture — only its owner uploads it.
    match /userGroups/{groupId}/photo/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && firestore.get(/databases/(default)/documents/userGroups/$(groupId)).data.ownerId == request.auth.uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Group post/chat attachments — members only (admins can view).
    match /userGroups/{groupId}/{kind}/{itemId}/{fileName} {
      allow read: if signedIn()
        && (firestore.exists(/databases/(default)/documents/userGroups/$(groupId)/members/$(request.auth.uid))
            || isAdmin());
      allow create: if signedIn()
        && (kind == 'posts' || kind == 'messages')
        && firestore.exists(/databases/(default)/documents/userGroups/$(groupId)/members/$(request.auth.uid))
        && communityFile();
      allow update, delete: if false;
    }

    // ID photos attached to wallet withdrawal requests — private to the
    // user and the admins reviewing the request.
    match /withdrawals/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Everything else (admin-curated content uploaded from the Vue
    // dashboard — thumbnails/, posts/{type}s/, etc.) — same permissive,
    // authenticated-only posture as firestore.rules uses for /posts,
    // /categories, /packages and friends.
    //
    // Storage grants access if ANY matching rule allows it, so the folders
    // with their own rules above are excluded here — otherwise this
    // catch-all would silently override their checks.
    match /{topFolder}/{allPaths=**} {
      allow read, write: if request.auth != null
        && !(topFolder in ['threadPosts', 'conversations', 'subcategoryFeeds',
                           'userGroups', 'withdrawals']);
    }
  }
}
