rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // ── Cross-service lookups (firestore.get / firestore.exists) ─────────
    // In production these only work once the Storage service agent has been
    // granted the "Firebase Rules Firestore Service Agent" role
    // (roles/firebaserules.firestoreServiceAgent). The emulator never
    // enforces that, so tests pass while production denies the request.
    // Every path the app WRITES to is therefore authorised from the path
    // and request.auth alone; lookups are only used as an optional extra
    // way to READ (admins, other group members via the SDK) and by the
    // legacy paths of older app builds. Files are normally read through
    // their download URL (token), which doesn't evaluate these rules.

    // Same admin check as firestore.rules / functions/admin/isAdmin.js.
    // Needs the cross-service grant above.
    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.get('email', '').lower()));
    }

    // Subcategory feeds/chat and user groups (MediaLimits.community in the
    // app): images, a video (≤ 5 min — duration is checked in the app, so
    // the size cap is generous), PDFs and audio of at most 50 MB each.
    function communityFile() {
      return (request.resource.contentType.matches('image/.*')
                && request.resource.size < 8 * 1024 * 1024)
        || (request.resource.contentType.matches('video/.*')
                && request.resource.size < 1024 * 1024 * 1024)
        || (request.resource.contentType == 'application/pdf'
                && request.resource.size <= 50 * 1024 * 1024)
        || (request.resource.contentType.matches('audio/.*')
                && request.resource.size <= 50 * 1024 * 1024);
    }

    match /threadPosts/{postId}/{fileName} {
      allow read: if request.auth != null;
      // Images (up to 5 per post), or one video of at most 10 minutes —
      // duration is checked in the app, so the size cap here is generous.
      allow write: if request.auth != null
        && ((request.resource.size < 8 * 1024 * 1024
              && request.resource.contentType.matches('image/.*'))
          || (request.resource.size < 2 * 1024 * 1024 * 1024
              && request.resource.contentType.matches('video/.*')));
      // Deletes happen via the cleanupThreadPost Cloud Function (Admin SDK,
      // bypasses these rules) when the Firestore doc is deleted.
      allow delete: if false;
    }

    // A conversation id IS its two participants' uids, sorted and joined
    // with '_' — firestore.rules refuses any other id on create — so
    // membership is read straight from the path (no Firestore lookup).
    function isConversationParticipant(conversationId) {
      return signedIn()
        && conversationId.split('_').size() == 2
        && request.auth.uid in conversationId.split('_');
    }

    // Private 1:1 chat attachments (MediaLimits.directMessage in the app):
    // images, a video (≤ 5 min, checked in the app), PDFs and audio ≤ 50 MB
    // — only the two participants upload or read them.
    match /conversations/{conversationId}/{messageId}/{fileName} {
      allow read: if isConversationParticipant(conversationId);
      allow create: if isConversationParticipant(conversationId) && communityFile();
      allow update, delete: if false;
    }

    // subcategoryFeeds/{categoryId}/posts/{postId}/… and …/messages/{id}/…
    // — open to every signed-in user, like the Firestore docs.
    match /subcategoryFeeds/{categoryId}/{kind}/{itemId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (kind == 'posts' || kind == 'messages')
        && communityFile();
      // Removed by the cleanup Cloud Functions with the post/message.
      allow update, delete: if false;
    }

    // A user group's profile picture: userGroups/{g}/photo/{uploaderUid}/…
    // Anyone may upload into THEIR OWN folder (the app does it before the
    // group doc exists, so a Firestore owner check couldn't work anyway);
    // only the owner can make it the group's picture — firestore.rules
    // requires photoPath to be under userGroups/{g}/photo/{ownerUid}/.
    match /userGroups/{groupId}/photo/{uid}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Group post/chat attachments: userGroups/{g}/{posts|messages}/{itemId}/
    // {uploaderUid}/{file}. Writable by the uploader into their own folder
    // only; firestore.rules only lets a MEMBER create the post/message that
    // references them, and requires every attachment path to sit in that
    // author's folder for that doc. Read: the uploader, plus (if the
    // cross-service grant exists) members and admins.
    match /userGroups/{groupId}/{kind}/{itemId}/{uid}/{fileName} {
      allow read: if signedIn()
        && (request.auth.uid == uid
            || firestore.exists(/databases/(default)/documents/userGroups/$(groupId)/members/$(request.auth.uid))
            || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && (kind == 'posts' || kind == 'messages')
        && communityFile();
      allow update, delete: if false;
    }

    // LEGACY (app builds before uploader-scoped paths): owner check via a
    // cross-service lookup — works only with the IAM grant described above.
    match /userGroups/{groupId}/photo/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && firestore.get(/databases/(default)/documents/userGroups/$(groupId)).data.ownerId == request.auth.uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    // LEGACY group post/chat attachments (older app builds) — members only
    // via a cross-service lookup; needs the IAM grant described above.
    match /userGroups/{groupId}/{kind}/{itemId}/{fileName} {
      allow read: if signedIn()
        && (firestore.exists(/databases/(default)/documents/userGroups/$(groupId)/members/$(request.auth.uid))
            || isAdmin());
      allow create: if signedIn()
        && (kind == 'posts' || kind == 'messages')
        && firestore.exists(/databases/(default)/documents/userGroups/$(groupId)/members/$(request.auth.uid))
        && communityFile();
      allow update, delete: if false;
    }

    // ID photos attached to wallet withdrawal requests — private to the
    // user and the admins reviewing the request. The admin branch (the
    // dashboard's getDownloadURL) needs the cross-service grant above.
    match /withdrawals/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Everything else (admin-curated content uploaded from the Vue
    // dashboard — thumbnails/, posts/{type}s/, etc.) — same permissive,
    // authenticated-only posture as firestore.rules uses for /posts,
    // /categories, /packages and friends.
    //
    // Storage grants access if ANY matching rule allows it, so the folders
    // with their own rules above are excluded here — otherwise this
    // catch-all would silently override their checks.
    match /{topFolder}/{allPaths=**} {
      allow read, write: if request.auth != null
        && !(topFolder in ['threadPosts', 'conversations', 'subcategoryFeeds',
                           'userGroups', 'withdrawals']);
    }
  }
}
