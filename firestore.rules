rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read, write: if request.auth != null;
      // likeCount/commentCount are server-only (maintained by Cloud Functions
      // via the Admin SDK, which bypasses these rules) — block direct client
      // writes to those fields specifically.
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['likeCount', 'commentCount']);

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // User-generated feed posts (distinct from the admin-curated /posts
    // collection above) — ownership is enforced here since any member can
    // publish to it, unlike admin content.
    match /threadPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      // Author-only, and (like /posts) likeCount/commentCount stay
      // server-only even for the author — they're maintained by Cloud
      // Functions via the Admin SDK, which bypasses these rules.
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['likeCount', 'commentCount']);
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /categories/{document=**}    { allow read, write: if request.auth != null; }
    match /users/{document=**}         { allow read, write: if request.auth != null; }
    match /packages/{document=**}      { allow read, write: if request.auth != null; }
    match /notifications/{document=**} { allow read, write: if request.auth != null; }
    // subscriptions is only ever touched by Cloud Functions (Admin SDK, bypasses
    // these rules) — this entry just avoids an implicit deny if a client ever reads it.
    match /subscriptions/{document=**} { allow read, write: if request.auth != null; }
  }
}
